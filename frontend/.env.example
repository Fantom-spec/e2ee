# Copy to frontend/.env (git-ignored). Both values are optional.

# Dev server proxies /api and /ws to this backend, so the browser stays
# same-origin and no CORS is needed during development.
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000

# Leave empty for same-origin (dev proxy, or backend serving the built site).
# Only set this if the API lives on a different origin; that origin must then
# be listed in SECURECHAT_ALLOWED_ORIGINS on the backend. Values are baked in
# at build time and are visible to every user, so never put secrets here.
VITE_API_BASE_URL=
