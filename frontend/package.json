{
  "name": "securechat-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "node --test \"tests/node/*.test.ts\"",
    "test:signal": "vitest run",
    "test": "npm run test:unit && npm run test:signal"
  },
  "dependencies": {
    "@privacyresearch/libsignal-protocol-typescript": "0.0.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.5.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
