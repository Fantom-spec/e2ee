# Copy to `.env` in the project root and edit. `.env` is git-ignored.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# "development" enables /api/docs and allows http:// origins. Anything else
# (including unset) behaves as "production".
SECURECHAT_ENV=development

# REQUIRED, >= 32 chars. The server refuses to start without it.
SECURECHAT_SECRET_KEY=

# REQUIRED. Comma-separated exact origins allowed to call the API (no wildcards).
# Local dev with the Vite server:
SECURECHAT_ALLOWED_ORIGINS=http://localhost:5173
# For a Cloudflare Tunnel demo, use your https tunnel origin, e.g.
# SECURECHAT_ALLOWED_ORIGINS=https://<your-tunnel-hostname>

# SQLite file location (relative to where the backend is started).
SECURECHAT_DB_PATH=data/securechat.sqlite3

# Optional tuning (defaults shown).
SECURECHAT_SESSION_TTL_SECONDS=43200
SECURECHAT_MESSAGE_TTL_SECONDS=604800
SECURECHAT_MAX_ENVELOPE_BYTES=65536

# Stage 2 tuning (defaults shown).
SECURECHAT_MAX_PENDING_PER_RECIPIENT=1000
SECURECHAT_MAX_CONNECTIONS_PER_USER=5
# scrypt cost exponent (N = 2^value). Production requires >= 15.
SECURECHAT_SCRYPT_LOG_N=17
# Set to true ONLY when the server is reachable exclusively through Cloudflare
# Tunnel, so per-IP rate limits use the real client IP. If it is reachable
# directly, clients could forge the header and evade the limits.
SECURECHAT_TRUST_CF_CONNECTING_IP=false
